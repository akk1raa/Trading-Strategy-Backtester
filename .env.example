# Copy to .env for your own reference, or export these in your shell. Never commit the real values.
# Needed only for the "YouTube link -> strategy" step.
ANTHROPIC_API_KEY=your-key-here

# Optional: override the model used for extraction (default: claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# No API key? Use a free local model instead (see README: Ollama).
# GCBT_LLM=auto            # auto | anthropic | ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=127.0.0.1:11434
